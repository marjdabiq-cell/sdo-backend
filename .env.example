# === مفاتيح الذكاء الاصطناعي ===
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here

# === واتساب (اتركها فارغة عند استخدام Baileys) ===
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=sdo_verify_2024

# === الأمان ===
ALLOWED_SENDER_NUMBER=9639XXXXXXXX

# === قاعدة البيانات (Railway Volume) ===
